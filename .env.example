# Copy to .env and fill in. Never commit .env.
# Any setting in config.yaml can also be overridden here using its UPPERCASE name.

# --- Slack (required to run the bot) ---------------------------------------
# From https://api.slack.com/apps -> your app (Socket Mode enabled)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel to ingest "tribal knowledge" threads from (ID like C0123456789, or the channel name)
# SLACK_CHANNEL_ID=aerostream-support

# --- Pipeline overrides (defaults live in config.yaml) ---------------------
# RETRIEVAL_STRATEGY=semantic      # semantic | semantic-rerank | lexical
# LLM_MODEL_NAME=llama             # llama (= llama3.2) | mistral | any Ollama model tag
# VECTOR_DB=chroma                 # chroma | pinecone

# --- Pinecone (only if VECTOR_DB=pinecone) ----------------------------------
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_NAME=aerostream-docs

# --- RAGAS evaluation (scripts/evaluate_ragas.py) ---------------------------
# Claude is used as the LLM judge
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-haiku-5-5
